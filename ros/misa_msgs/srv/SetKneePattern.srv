# 膝の向きと、反転のやり方。
#
# **どこからどこへでも 1 回の振り付けで行く。** 立って止まっているときだけ
# 受け付け、歩いている最中の要求は ok = false と理由が返る。
#
# pattern  0 = <<  1 = <>  2 = ><  3 = >>
#          （<< は 4 脚とも後ろ向き、>> は 4 脚とも前向き）
# style    0 = 今のまま  1 = stand（1 脚ずつ、3 脚支持）
#          2 = pitch（一斉に伸ばして折り返す）
#          3 = trot   4 = all   5 = rest
#
# **stand と pitch 以外は前提が要る。** trot は 2 点支持で静的に釣り合わず
# 数秒しか持たない。all は足を床で滑らせる。rest は車輪と腹で機体を支える。
uint8 pattern
uint8 style
---
bool ok
string message
